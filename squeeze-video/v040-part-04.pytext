f.write_text('''package com.squeezelab.video;
import org.junit.Test;
import static org.junit.Assert.*;
public class SmartCompressionTest {
 @Test public void target20Mb(){SmartCompression.Plan p=SmartCompression.plan(20,60000,96000,6000000);
  assertTrue(p.videoBitrate>2300000 && p.videoBitrate<2600000);assertFalse(p.limited);}
 @Test public void verySmallTargetClamps(){SmartCompression.Plan p=SmartCompression.plan(1,300000,128000,5000000);
  assertEquals(220000,p.videoBitrate);assertTrue(p.limited);}
 @Test public void respectsSourceRate(){SmartCompression.Plan p=SmartCompression.plan(500,60000,96000,1000000);
  assertTrue(p.videoBitrate<=720000);}
 @Test(expected=IllegalArgumentException.class) public void rejectInvalid(){SmartCompression.parseMb("NaN");}
}
