        hevc.setEnabled(available);hevc.setChecked(hevcEnabled && available);panel.addView(hevc);
        panel.addView(text("Output size is approximate. Original videos stay unchanged.",12,MUTED));
        new AlertDialog.Builder(this).setTitle("Smart export")
            .setView(panel).setNegativeButton("Cancel",null)
            .setPositiveButton("Apply",(d,w)->{
                if(target.isChecked())try{SmartCompression.parseMb(mb.getText().toString());}
                catch(IllegalArgumentException ex){toast(ex.getMessage());return;}
                smartEnabled=target.isChecked();smartMb=mb.getText().toString();
                hevcEnabled=available && hevc.isChecked();
                getPreferences(MODE_PRIVATE).edit().putBoolean("smart_enabled",smartEnabled)
                    .putBoolean("smart_hevc",hevcEnabled).putString("smart_mb",smartMb).apply();
            }).show();
    }

    private String qualityName() {''')
