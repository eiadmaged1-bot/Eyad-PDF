+    private void openWatermarkSettings(){
+        if(busy())return;
+        LinearLayout panel=vertical();panel.setPadding(dp(18),dp(8),dp(18),dp(10));
+        panel.addView(text("Use your course logo (transparent PNG recommended). The logo is burned into the exported video.",13,MUTED),margin(-1,-2,9));
+        Button selectLogo=button(studioLogo.isEmpty()?"Choose course logo":"Change course logo",true);
+        selectLogo.setOnClickListener(v->pickLogo());
+        panel.addView(selectLogo,margin(-1,dp(52),9));
+        panel.addView(text("Watermark position",14,INK),margin(-1,-2,5));
+        Spinner corner=new Spinner(this);
+        String[] labels={"Top right","Top left","Bottom right","Bottom left"};
+        ArrayAdapter<String> adapter=new ArrayAdapter<>(this,android.R.layout.simple_spinner_dropdown_item,labels);
+        corner.setAdapter(adapter);
+        corner.setSelection(WatermarkSettings.closestCorner(logoX,logoY));
+        panel.addView(corner,margin(-1,dp(52),7));
+        TextView sizeLabel=text("Logo scale: "+watermarkSize+"%",14,INK);
+        panel.addView(sizeLabel);
+        SeekBar size=new SeekBar(this);size.setMax(45);size.setProgress(watermarkSize-10);
+        size.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener(){
+            public void onStartTrackingTouch(SeekBar s){}
+            public void onStopTrackingTouch(SeekBar s){}
+            public void onProgressChanged(SeekBar s,int progress,boolean user){sizeLabel.setText("Logo scale: "+(progress+10)+"%");}
+        });panel.addView(size);
+        TextView alphaLabel=text("Opacity: "+watermarkOpacity+"%",14,INK);
+        panel.addView(alphaLabel);
+        SeekBar alpha=new SeekBar(this);alpha.setMax(90);alpha.setProgress(watermarkOpacity-10);
+        alpha.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener(){
+            public void onStartTrackingTouch(SeekBar s){}
+            public void onStopTrackingTouch(SeekBar s){}
+            public void onProgressChanged(SeekBar s,int progress,boolean user){alphaLabel.setText("Opacity: "+(progress+10)+"%");}
+        });panel.addView(alpha);
+        panel.addView(text("Preview placement is approximate. Original video remains unchanged.",12,MUTED),margin(-1,-2,5));
+        new AlertDialog.Builder(this).setTitle("Course watermark")
+            .setView(panel)
+            .setNeutralButton("Remove logo",(d,w)->{studioLogo="";persistAdvanced();refreshVisualPreview();})
+            .setNegativeButton("Cancel",null)
+            .setPositiveButton("Apply",(d,w)->{
+                float[] xy=WatermarkSettings.position(corner.getSelectedItemPosition());
+                logoX=xy[0];logoY=xy[1];
+                watermarkSize=WatermarkSettings.size(size.getProgress()+10);
+                watermarkOpacity=WatermarkSettings.opacity(alpha.getProgress()+10);
+                persistAdvanced();refreshVisualPreview();positionPreview();
+                toast(studioLogo.isEmpty()?"Choose a course logo to enable watermark":"Course watermark saved for export");
+            }).show();
+    }
