        CheckBox target=new CheckBox(this);target.setText("Aim for target size in MB");
        target.setChecked(smartEnabled);panel.addView(target);
        EditText mb=new EditText(this);mb.setSingleLine(true);mb.setText(smartMb);
        mb.setHint("MB · e.g. 25");
        mb.setInputType(android.text.InputType.TYPE_CLASS_NUMBER |
                android.text.InputType.TYPE_NUMBER_FLAG_DECIMAL);
        mb.setEnabled(smartEnabled);target.setOnCheckedChangeListener((v,b)->mb.setEnabled(b));
        panel.addView(mb,margin(-1,dp(48),4));
        CheckBox hevc=new CheckBox(this);
        boolean available=CodecSupport.hevcAvailable();
        hevc.setText(available?"H.265 / HEVC · smaller, less compatible":"H.265 unavailable");
