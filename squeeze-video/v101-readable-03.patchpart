diff -ruN '--exclude=*.orig' base/app/src/main/java/com/squeezelab/video/WatermarkSettings.java v100/app/src/main/java/com/squeezelab/video/WatermarkSettings.java
--- base/app/src/main/java/com/squeezelab/video/WatermarkSettings.java	1970-01-01 00:00:00.000000000 +0000
+++ v100/app/src/main/java/com/squeezelab/video/WatermarkSettings.java	2026-11-02 21:22:07.026627139 +0000
@@ -0,0 +1,20 @@
+package com.squeezelab.video;
+
+/** Course logo placement policy, independent of Android framework for testing. */
+final class WatermarkSettings {
+    private WatermarkSettings(){}
+    static int size(int value){return Math.max(10,Math.min(55,value));}
+    static int opacity(int value){return Math.max(10,Math.min(100,value));}
+    static float[] position(int corner){
+        switch(corner){
+            case 1:return new float[]{-.72f,-.76f};
+            case 2:return new float[]{.72f,.76f};
+            case 3:return new float[]{-.72f,.76f};
+            default:return new float[]{.72f,-.76f};
+        }
+    }
+    static int closestCorner(float x,float y){
+        if(x<0)return y>0?3:1;
+        return y>0?2:0;
+    }
+}
diff -ruN '--exclude=*.orig' base/app/src/test/java/com/squeezelab/video/WatermarkSettingsTest.java v100/app/src/test/java/com/squeezelab/video/WatermarkSettingsTest.java
--- base/app/src/test/java/com/squeezelab/video/WatermarkSettingsTest.java	1970-01-01 00:00:00.000000000 +0000
+++ v100/app/src/test/java/com/squeezelab/video/WatermarkSettingsTest.java	2026-11-02 21:22:07.026664376 +0000
@@ -0,0 +1,20 @@
+package com.squeezelab.video;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public final class WatermarkSettingsTest {
+    @Test public void clampsSizeAndAlpha(){
+        assertEquals(10,WatermarkSettings.size(-3));
+        assertEquals(55,WatermarkSettings.size(87));
+        assertEquals(10,WatermarkSettings.opacity(2));
+        assertEquals(100,WatermarkSettings.opacity(150));
+    }
+    @Test public void cornersStayInsideScreenAndRoundTrip(){
+        for(int corner=0;corner<4;corner++){
+            float[] xy=WatermarkSettings.position(corner);
+            assertTrue(Math.abs(xy[0])<.9f && Math.abs(xy[1])<.9f);
+            assertEquals(corner,WatermarkSettings.closestCorner(xy[0],xy[1]));
+        }
+    }
+}
