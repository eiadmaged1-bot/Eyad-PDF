            estimate=plan==null ? CompressionMath.estimatedBytes(videoInfo.durationMs,
                    currentBitrate(),currentPreset().audioBitrate) : plan.estimatedBytes;
            smartNote.setText(plan==null ? "Estimated size only · encoder may vary" :
                    (plan.limited ? "Requested size is outside bitrate limits · approximation only" :
                    "Target approximate · final size depends on encoder"));
        } catch (IllegalArgumentException ex){
            estimateText.setText("Invalid target MB"); smartNote.setText(ex.getMessage()); return;
        }''')
